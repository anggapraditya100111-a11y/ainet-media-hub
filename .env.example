OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_POST_LOGOUT_REDIRECT_URI=
OIDC_SCOPES=openid profile email
OIDC_ALLOWED_EMAIL_DOMAINS=
OIDC_AUTO_PROVISION=true
OIDC_ROLE_MAPPING_JSON=
# Login username/password khusus untuk Super Admin dan Vendor
LOCAL_PERSONAL_LOGIN_ENABLED=true
OIDC_ALLOW_INSECURE=false
