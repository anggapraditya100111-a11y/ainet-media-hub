APP_PORT=8095
DATA_ROOT=./runtime
APP_PEPPER=GANTI_DENGAN_RANDOM_SECRET_MINIMAL_64_KARAKTER
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=GantiPasswordAdmin123
DEFAULT_APP_NAME=AXINDO Media Hub
DEFAULT_COMPANY_NAME=PT Axindo Infinitas Network
PUBLIC_APP_URL=https://mediahub.axindo.my.id
ACCESS_PORTAL_URL=https://akses.axindo.my.id
TRUST_PROXY=false
COOKIE_SECURE=false
SESSION_HOURS=12
MAX_UPLOAD_MB=50
SEED_DEMO=false

# AXINDO ID / Authentik (aktifkan melalui ./configure-oidc.sh)
OIDC_ENABLED=false
OIDC_ISSUER_URL=https://sso.axindo.my.id/application/o/axindo-media-hub/
